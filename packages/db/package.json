{
  "name": "@agentpm/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "migrate": "tsx scripts/migrate-dev.ts",
    "migrate:deploy": "tsx scripts/migrate-deploy.ts",
    "db:push": "prisma db push --skip-generate",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentpm/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/client": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
