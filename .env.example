# AgentPM environment configuration
# Copy to .env and adjust. NEVER commit real .env files.

# --- Database (MySQL 8) ---
# Local docker-compose example:
# DATABASE_URL=mysql://root:agentpm@localhost:3306/agentpm_dev
DATABASE_URL=mysql://user:password@localhost:3306/agentpm_dev
# Used by the test suite (vitest). Falls back to DATABASE_URL with db name swapped to agentpm_test.
TEST_DATABASE_URL=mysql://user:password@localhost:3306/agentpm_test
# Same credentials, but pointing at the `mysql` system database (used to CREATE DATABASE IF NOT EXISTS in tests)
ROOT_DATABASE_URL=mysql://user:password@localhost:3306/mysql

# --- API server ---
PORT=3000
HOST=127.0.0.1
# Secret for session JWT signing. Generate one: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Comma separated list of allowed browser origins (CORS). Use * only for development.
CORS_ORIGINS=http://localhost:5173

# --- First admin account (used by `pnpm seed`) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe!AgentPM2026
SEED_ADMIN_EMAIL=admin@example.com

# --- Agent / MCP behaviour ---
# Max MCP tool calls per token per minute (token bucket)
MCP_RATE_LIMIT_PER_MIN=120
# Default per-agent concurrent claimed issues when a project does not override it
AGENT_MAX_CONCURRENT_CLAIMS=3
# Set to 1 after applying scripts/db/fulltext.sql to enable MySQL FULLTEXT (ngram) search
FULLTEXT_ENABLED=0

# --- Logging ---
LOG_LEVEL=info

# --- PM 替身（M5，apps/avatar-worker） ---
# 替身（AVATAR 类型账号）的 token：监控中心页"创建替身"或 POST /v1/agents {actorType:"AVATAR"} 签发
AVATAR_TOKEN=
AGENTPM_API_URL=http://127.0.0.1:3000
# 巡检间隔（分钟，常驻模式）
AVATAR_INTERVAL_MIN=15

# --- LLM 增强（可选；不配置则替身以纯规则运行） ---
# 任意 OpenAI 兼容端点：智谱 GLM https://open.bigmodel.cn/api/paas/v4 / OpenAI / 本地 Ollama http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=30000

# --- M6: 附件上传 ---
# 附件落盘目录（默认 <repo>/data/uploads；磁盘文件名=附件 id）
ATTACHMENTS_DIR=

# --- M6: 邮件通知（可选；SMTP_HOST 留空 = 邮件关闭，通知只在站内） ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 发件人地址，如 AgentPM <agentpm@example.com>
SMTP_FROM=
# 站点对外地址（通知邮件里的跳转链接前缀）
APP_URL=http://localhost:5173
